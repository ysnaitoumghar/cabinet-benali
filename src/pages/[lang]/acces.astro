---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../config/site';
import { access } from '../../config/content';
import { ui } from '../../i18n/ui';
import { langs, tr, type Lang } from '../../lib/l10n';
import { fill, telHref, waLink } from '../../lib/whatsapp';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const { lat, lon, zoomSpan } = site.map;
const bbox = [lon - zoomSpan, lat - zoomSpan * 0.7, lon + zoomSpan, lat + zoomSpan * 0.7].join('%2C');
const embed = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat}%2C${lon}`;
const osm = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=18/${lat}/${lon}`;
---
<Layout lang={lang} title={t.meta.accessTitle} description={t.meta.accessDesc} path="acces/" ogPhoto="salle-attente" jsonLd>
  <div class="page-top section">
    <div class="wrap">
      <h1 class="font-display h1 mb-5">{t.sections.access.title}</h1>
      <p class="lead mb-10">{tr(access.intro, lang)}</p>

      <div class="grid items-start gap-10 md:grid-cols-[1.3fr_1fr] md:gap-16">
        <div data-reveal>
          <div class="map-frame">
            <iframe src={embed} title={t.location.mapLabel} loading="lazy" referrerpolicy="no-referrer" data-map></iframe>
            <button type="button" class="map-veil" data-map-veil aria-label={t.location.mapActivate}><span>{t.location.mapActivate}</span></button>
          </div>
          <div class="mt-4 flex flex-col gap-3 sm:flex-row">
            <a class="btn btn-ghost" href={osm} target="_blank" rel="noopener"><Icon name="pin" />{t.cta.openMap}</a>
            <a class="btn btn-primary" href={waLink(fill(t.generic.whatsappMsg, { clinic: site.name }))} target="_blank" rel="noopener"><Icon name="chat" />{t.cta.whatsapp}</a>
          </div>
          <p class="mt-4 text-[0.9375rem]"><strong class="font-medium">{t.location.address} :</strong> {tr(site.address, lang)}</p>
          <p class="muted mt-1 text-[0.9375rem]">
            <Icon name="phone" size={16} class="mr-1 inline align-[-3px]" />
            <a href={telHref}><bdi dir="ltr">{site.phone}</bdi></a>
          </p>
        </div>

        <div data-reveal class="delay-1">
          <h2 class="font-display h3 mb-4">{t.location.details}</h2>
          <ul class="grid gap-5">
            {access.items.map((it) => (
              <li class="flex items-start gap-4">
                <span class="icon-badge"><Icon name={it.icon} size={22} /></span>
                <div>
                  <h3 class="font-semibold leading-snug">{tr(it.title, lang)}</h3>
                  <p class="muted mt-1 text-[0.9375rem]">{tr(it.text, lang)}</p>
                </div>
              </li>
            ))}
          </ul>

          <h2 class="font-display h3 mb-3 mt-10">{t.hours.title}</h2>
          <dl class="card px-4">
            {t.hours.lines.map((h) => <div class="row"><dt>{h.days}</dt><dd class="muted"><bdi dir="ltr">{h.time}</bdi></dd></div>)}
          </dl>
        </div>
      </div>
    </div>
  </div>
</Layout>
