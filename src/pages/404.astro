---
import Layout from '../layouts/Layout.astro';
import { ui } from '../i18n/ui';
import { site } from '../config/site';
import { pageUrl } from '../lib/l10n';
const lang = site.defaultLang;
const t = ui[lang].notFound;
---
<Layout lang={lang} title={t.title} description={t.text}>
  <section class="section page-top min-h-[70dvh]">
    <div class="wrap">
      <h1 class="font-display h1 mb-4">{t.title}</h1>
      <p class="lead mb-8">{t.text}</p>
      <a class="btn btn-primary" href={pageUrl(lang)}>{t.home}</a>
    </div>
  </section>
</Layout>
